{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build.py && python3 scripts/write_health.py",
  "cleanUrls": true,
  "functions": {
    "api/review-queue.js": {
      "maxDuration": 10,
      "includeFiles": "data/v1/**"
    },
    "api/review-decide.js": {
      "maxDuration": 10,
      "includeFiles": "data/v1/**"
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"
        }
      ],
      "source": "/data/v1/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ],
      "source": "/assets/(.*)"
    },
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ],
      "source": "/api/(.*)"
    },
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "installCommand": "echo 'no dependencies'",
  "outputDirectory": "site",
  "trailingSlash": false
}
