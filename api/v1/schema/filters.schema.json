{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "FiltersResponse",
 "type": "object",
 "required": [
  "filters",
  "updated"
 ],
 "properties": {
  "filters": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "object",
    "required": [
     "type"
    ],
    "properties": {
     "type": {
      "type": "string",
      "enum": [
       "range",
       "select",
       "multiselect",
       "boolean",
       "text"
      ]
     },
     "min": {
      "type": "number"
     },
     "max": {
      "type": "number"
     },
     "unit": {
      "type": "string"
     },
     "options": {
      "type": "array"
     },
     "labels": {
      "type": "object"
     },
     "fields": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "description": {
      "type": "string"
     }
    }
   }
  },
  "updated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  }
 }
}