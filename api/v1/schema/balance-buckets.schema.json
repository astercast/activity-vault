{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "BalanceBucketsResponse",
 "type": "object",
 "required": [
  "buckets",
  "mapping",
  "count",
  "updated"
 ],
 "properties": {
  "buckets": {
   "type": "array",
   "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "BalanceBucket",
    "type": "object",
    "required": [
     "id",
     "label",
     "glyph",
     "description"
    ],
    "properties": {
     "id": {
      "type": "string",
      "enum": [
       "movement",
       "calm",
       "creative",
       "outdoor",
       "mixed"
      ]
     },
     "label": {
      "type": "string"
     },
     "glyph": {
      "type": "string"
     },
     "description": {
      "type": "string"
     }
    }
   }
  },
  "mapping": {
   "type": "array",
   "minItems": 11,
   "maxItems": 11,
   "items": {
    "type": "object",
    "required": [
     "category",
     "category_name",
     "bucket",
     "bucket_label",
     "bucket_glyph"
    ],
    "properties": {
     "category": {
      "type": "string"
     },
     "category_name": {
      "type": "string"
     },
     "bucket": {
      "type": "string",
      "enum": [
       "movement",
       "calm",
       "creative",
       "outdoor",
       "mixed"
      ]
     },
     "bucket_label": {
      "type": "string"
     },
     "bucket_glyph": {
      "type": "string"
     }
    }
   }
  },
  "count": {
   "type": "integer",
   "minimum": 0
  },
  "updated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  }
 }
}